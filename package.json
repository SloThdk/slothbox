{
  "name": "slothbox",
  "version": "0.2.16",
  "private": true,
  "description": "End-to-end encrypted file transfer. Server cannot decrypt anything — open source, audit the claim.",
  "license": "MIT",
  "author": "Philip Sloth <philipsloth1@gmail.com> (https://philipsloth.com)",
  "homepage": "https://github.com/SloThdk/slothbox",
  "repository": {
    "type": "git",
    "url": "https://github.com/SloThdk/slothbox.git"
  },
  "bugs": {
    "url": "https://github.com/SloThdk/slothbox/issues"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@9.12.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "compose:rebuild": "docker compose build --no-cache",
    "db:migrate": "pnpm --filter @slothbox/db run migrate",
    "db:reset": "pnpm --filter @slothbox/db run reset",
    "verify:secrets": "gitleaks detect --no-git --redact",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.6",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10",
      "esbuild@<=0.24.2": ">=0.25.0",
      "vite@<=6.4.1": ">=6.4.2",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "hono@<4.12.21": ">=4.12.21",
      "shell-quote@<1.8.4": ">=1.8.4"
    }
  }
}
