# Secrets — NEVER COMMIT THESE.
# Match the bare .env AND every .env.* variant (including ad-hoc backups like
# .env.before-sync-*, which the old enumerated list missed — one `git add .`
# from staging real secrets). Un-ignore only the committed example templates;
# the leading-slash-free negation un-ignores .env.example in any directory
# (root + apps/web).
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
.secrets/

# Dependencies
node_modules/
.pnpm-store/
.pnpm-debug.log

# Build artifacts
.next/
out/
dist/
build/
target/
bin/
obj/
*.tsbuildinfo

# Generated by apps/web/scripts/build-sw.mjs (prebuild/predev) —
# source of truth is apps/web/scripts/sw-template.js. Never edit by hand.
apps/web/public/sw.js

# .NET
**/bin/
**/obj/
**/.vs/
*.user
*.suo

# Go
**/vendor/
*.exe
*.test
*.prof

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS
*~
.~lock.*

# Coverage + test
coverage/
.nyc_output/
*.lcov

# Docker volumes (when run locally without named volumes)
data/
volumes/

# Local override files
docker-compose.override.yml
*.local.yml

# Backups + dumps
*.sql.gz
*.dump
backups/

# Crypto test artifacts
test-keys/
test-shares/

# AI tooling
.claude/
.cursor/
